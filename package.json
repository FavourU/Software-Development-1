{
  "name": "trivia-quiz",
  "version": "1.0.0",
  "description": "Valentine's Day trivia quiz with TDD",
  "main": "js/quiz.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:phase1": "jest tests/quiz-phase1.test.js",
    "test:phase2": "jest tests/quiz-phase2.test.js",
    "test:phase3": "jest tests/quiz-phase3.test.js",
    "test:all-phases": "npm run test:phase1 && npm run test:phase2 && npm run test:phase3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}